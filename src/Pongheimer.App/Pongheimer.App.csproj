<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>oPongheimer</AssemblyName>
    <RootNamespace>Pongheimer</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- WinForms потрібен лише як джерело системних послуг: GDI+ для тексту, буфер обміну, вікно помилки -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- WinForms радить задавати DPI через свій Application, але вікно тут створює MonoGame, тож діє лише маніфест -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>

    <!-- Іконка exe; генерується скриптом tools\make-icon.ps1 -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>

    <!-- Один самодостатній exe: другу не треба ставити .NET -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Інакше Color, Rectangle, Keys тощо конфліктують з однойменними типами MonoGame -->
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <!-- Та сама іконка як ресурс — для заголовка вікна й панелі завдань -->
    <EmbeddedResource Include="Assets\app.ico" LogicalName="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.WindowsDX" Version="3.8.4" />
    <ProjectReference Include="..\Pongheimer.Core\Pongheimer.Core.csproj" />
  </ItemGroup>

</Project>
